# Copy to `.env` and fill in. `.env` is gitignored; never commit a real value.

# The steward console's write gate. UNSET IS THE SAFE DEFAULT: with no token the console runs
# read-only and every write endpoint returns 403, which is what a public demo link should do.
# Generate one with:  openssl rand -hex 16
CR_APPROVER_TOKEN=

# Where the console keeps the merge ledger. `:memory:` is the default and is deliberate -- the
# demo's whole state is one ledger that a restart may reset, and a deployment that persisted
# approvals would need a retention answer this project has not written.
CR_DATABASE=:memory:
